<section class="panel">
  <header class="panel-head">
    <h2><%= t("app.expenses") %></h2>
    <button type="button" class="text-btn" data-action="composer#newExpense"><%= t("app.add_expense") %></button>
  </header>
  <% if summary.expenses.empty? %>
    <p class="empty-day"><%= t("app.empty_expenses") %></p>
  <% else %>
    <% summary.expenses_by_day.each do |date, lines| %>
      <h3 class="day-label<%= " is-today" if date == summary.today %>"><%= l(date, format: :day) %></h3>
      <ul class="day-list">
        <% lines.each do |line| %>
          <li class="day-item<%= " is-today" if date == summary.today %><%= " is-skipped" if line.skipped %>">
            <button type="button" class="item-main"
              data-action="composer#editExpense"
              data-id="<%= line.id %>"
              data-title="<%= line.title %>"
              data-amount="<%= amount_input(line.amount_cents) %>"
              data-currency="<%= line.currency %>"
              data-spent-on="<%= line.spent_on.iso8601 %>"
              data-category="<%= line.category %>"
              data-notes="<%= line.notes %>"
              data-heading="<%= t("app.edit_expense") %>">
              <span class="item-kind"><%= line.title %></span>
              <% if line.category.present? %>
                <span class="item-note"><%= t("categories.#{line.category}") %></span>
              <% elsif line.notes.present? %>
                <span class="item-note"><%= line.notes %></span>
              <% end %>
            </button>
            <span class="row-amount"><%= line.skipped ? t("app.skipped") : money_pair(line) %></span>
            <button type="button" class="item-del" data-action="confirm#open" data-url="<%= expense_path(line.id) %>" data-message="<%= t("js.delete_expense_confirm") %>" aria-label="<%= t("app.delete") %>">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.2 4.2 11.8 11.8M11.8 4.2 4.2 11.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            </button>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</section>
